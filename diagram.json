{
  "version": 1,
  "author": "Monitoramento de Fluxo de Agua",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "board-ssd1306", "id": "oled1", "top": 130, "left": 220, "attrs": { "i2cAddress": "0x3c" } },
    { "type": "wokwi-led", "id": "led1", "top": 40, "left": -180, "attrs": { "color": "red" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 150, "left": -150, "attrs": { "value": "220" } },
    { "type": "wokwi-potentiometer", "id": "pot1", "top": -60, "left": -170, "attrs": {} }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "esp:21", "oled1:SDA", "green", [] ],
    [ "esp:22", "oled1:SCL", "yellow", [] ],
    [ "esp:3V3", "oled1:VCC", "red", [] ],
    [ "esp:GND.2", "oled1:GND", "black", [] ],

    [ "esp:25", "r1:2", "orange", [] ],
    [ "r1:1", "led1:A", "orange", [] ],
    [ "led1:C", "esp:GND.1", "black", [] ],

    [ "esp:26", "esp:27", "purple", [] ],

    [ "pot1:VCC", "esp:3V3", "red", [] ],
    [ "pot1:GND", "esp:GND.1", "black", [] ],
    [ "pot1:SIG", "esp:34", "blue", [] ]
  ],
  "dependencies": {}
}
